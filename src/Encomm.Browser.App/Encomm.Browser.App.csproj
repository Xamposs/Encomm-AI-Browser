<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMrtResourceManager>false</EnableMrtResourceManager>
    <EnableDefaultMrtResources>false</EnableDefaultMrtResources>
    <EnableDefaultPriItems>false</EnableDefaultPriItems>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <AppxPackage>false</AppxPackage>
  <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  <NoWarn>$(NoWarn);CA1416;CA1840;CS8002;NU1701;MVVMTK0045;CS0067</NoWarn>
  <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  <RootNamespace>Encomm.Browser.App</RootNamespace>
    <AssemblyName>Encomm</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Encomm.Browser.Engine.Abstractions\Encomm.Browser.Engine.Abstractions.csproj" />
    <ProjectReference Include="..\Encomm.Browser.Core\Encomm.Browser.Core.csproj" />
    <ProjectReference Include="..\Encomm.Browser.Engine.WebView2\Encomm.Browser.Engine.WebView2.csproj" />
    <ProjectReference Include="..\Encomm.Browser.Tabs\Encomm.Browser.Tabs.csproj" />
    <ProjectReference Include="..\Encomm.Browser.Workspaces\Encomm.Browser.Workspaces.csproj" />
    <ProjectReference Include="..\Encomm.Browser.Memory\Encomm.Browser.Memory.csproj" />
    <ProjectReference Include="..\Encomm.Browser.Shield\Encomm.Browser.Shield.csproj" />
    <ProjectReference Include="..\Encomm.Browser.AI\Encomm.Browser.AI.csproj" />
    <ProjectReference Include="..\Encomm.Browser.Settings\Encomm.Browser.Settings.csproj" />
    <ProjectReference Include="..\Encomm.Browser.Security\Encomm.Browser.Security.csproj" />
    <ProjectReference Include="..\Encomm.Browser.Developer\Encomm.Browser.Developer.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Assets\wordmark\encomm-mark.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>