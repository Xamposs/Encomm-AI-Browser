<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Encomm.Browser.App.Dialogs.CanvasDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ENCOMM Canvas"
    CloseButtonText="Close">

    <Grid Width="740" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Intent: what the user is trying to accomplish with this workspace -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Intent" VerticalAlignment="Center"
                       Style="{ThemeResource EncommChromeText}" />
            <TextBox Grid.Column="1" x:Name="IntentBox"
                     PlaceholderText="What are you trying to accomplish with these pages?"
                     AutomationProperties.Name="Canvas intent" />
            <Button Grid.Column="2" x:Name="BuildButton" Content="Build canvas" Click="OnBuild"
                    AutomationProperties.Name="Build canvas" />
        </Grid>

        <TextBlock Grid.Row="1" x:Name="StatusText" TextWrapping="Wrap"
                   Style="{ThemeResource EncommQuietText}" />

        <!-- Generated workspace content -->
        <ScrollViewer Grid.Row="2" MaxHeight="380" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
                <TextBlock x:Name="CanvasTitle" TextWrapping="Wrap"
                           Style="{ThemeResource EncommDialogHeading}" />
                <TextBlock x:Name="CanvasSummary" TextWrapping="Wrap"
                           Style="{ThemeResource EncommChromeText}" />

                <!-- Comparison mode: a real table, built in code-behind -->
                <Border x:Name="TablePanel" Visibility="Collapsed"
                        Background="{ThemeResource EncommSurfaceBrush}"
                        BorderBrush="{ThemeResource EncommBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="8">
                    <Grid x:Name="TableHost" ColumnSpacing="10" RowSpacing="6" />
                </Border>

                <!-- Evidence / summary mode -->
                <ItemsControl x:Name="RowsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{ThemeResource EncommSurfaceBrush}"
                                    BorderBrush="{ThemeResource EncommBorderBrush}"
                                    BorderThickness="1" CornerRadius="8"
                                    Padding="10" Margin="0,0,0,8">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"
                                               Visibility="{Binding DetailVisibility}" />
                                    <ItemsControl ItemsSource="{Binding SourceChips}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Label}" Tag="{Binding TabId}"
                                                        Click="OnActivateSource" Padding="8,2"
                                                        Foreground="{ThemeResource EncommAccentCyanBrush}"
                                                        ToolTipService.ToolTip="{Binding Title}"
                                                        AutomationProperties.Name="{Binding AccessibleName}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel x:Name="UncertaintyPanel" Spacing="2" Visibility="Collapsed">
                    <TextBlock Text="Worth checking" Style="{ThemeResource EncommChromeTitle}" />
                    <ItemsControl x:Name="Uncertainties">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                           Style="{ThemeResource EncommQuietText}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="SourcePanel" Spacing="4" Visibility="Collapsed">
                    <TextBlock x:Name="SourceHeading" Text="Sources"
                               Style="{ThemeResource EncommChromeTitle}" />
                    <ItemsControl x:Name="Sources">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="OnActivateSource" Tag="{Binding TabId}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Margin="0,1" AutomationProperties.Name="{Binding AccessibleName}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="{ThemeResource EncommAccentCyanBrush}" />
                                        <TextBlock Text="{Binding Title}" MaxWidth="220"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Url}" MaxWidth="240"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{ThemeResource EncommQuietText}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Empty state: never a dead end -->
                <StackPanel x:Name="EmptyPanel" Spacing="8">
                    <TextBlock x:Name="EmptyText" TextWrapping="Wrap"
                               Style="{ThemeResource EncommChromeText}" />
                    <ItemsControl x:Name="Suggestions">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Click="OnUseSuggestion"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10">
            <ProgressRing x:Name="Busy" IsActive="False" Visibility="Collapsed" Width="18" Height="18" />
            <Button x:Name="CopyButton" Content="Copy canvas" Click="OnCopy" Visibility="Collapsed"
                    AutomationProperties.Name="Copy canvas" />
            <Button x:Name="DeleteButton" Content="Delete canvas" Click="OnDelete" Visibility="Collapsed"
                    AutomationProperties.Name="Delete canvas" />
            <TextBlock x:Name="Footnote" VerticalAlignment="Center" TextWrapping="Wrap"
                       Style="{ThemeResource EncommQuietText}" />
        </StackPanel>
    </Grid>
</ContentDialog>