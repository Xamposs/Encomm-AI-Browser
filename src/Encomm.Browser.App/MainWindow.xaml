<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Encomm.Browser.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Encomm.Browser.App"
    xmlns:vm="using:Encomm.Browser.App.ViewModels"
    xmlns:tabs="using:Encomm.Browser.Core.Storage"
    xmlns:controls="using:Encomm.Browser.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar / omnibox -->
        <Border Grid.Row="0" Padding="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Back" Command="{x:Bind ViewModel.BackCommand}" />
                <Button Grid.Column="1" Content="Forward" Command="{x:Bind ViewModel.ForwardCommand}" />
                <Button Grid.Column="2" Content="Reload" Command="{x:Bind ViewModel.ReloadCommand}" />
                <Button Grid.Column="3" Content="Stop" Command="{x:Bind ViewModel.StopCommand}" />
                <Button Grid.Column="4" Content="+" ToolTipService.ToolTip="New tab (Ctrl+T)" Command="{x:Bind ViewModel.NewTabCommand}" />
                <Button Grid.Column="5" Content="&#x21BA;" ToolTipService.ToolTip="Reopen closed (Ctrl+Shift+T)" Command="{x:Bind ViewModel.ReopenClosedCommand}" />

                <ComboBox Grid.Column="6"
                          MinWidth="120"
                          ItemsSource="{x:Bind ViewModel.Workspaces}"
                          SelectedItem="{x:Bind ViewModel.ActiveWorkspace, Mode=OneWay}"
                          DisplayMemberPath="Name"
                          SelectionChanged="OnWorkspaceSelectionChanged"
                          ToolTipService.ToolTip="Active workspace" />

                <TextBox Grid.Column="7"
                         x:Name="AddressBox"
                         Text="{x:Bind ViewModel.AddressBarText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnAddressKeyDown"
                         PlaceholderText="Search or enter address..."
                         Padding="6" />

                <Button Grid.Column="8" Content="Go" Command="{x:Bind ViewModel.NavigateCommand}" Style="{ThemeResource AccentButtonStyle}" />
                <Button Grid.Column="9" Content="..." ToolTipService.ToolTip="Menu" Click="OnMenuClicked">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="New Tab" Command="{x:Bind ViewModel.NewTabCommand}" />
                            <MenuFlyoutItem Text="Reopen Closed" Command="{x:Bind ViewModel.ReopenClosedCommand}" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Pin / Unpin Active" Command="{x:Bind ViewModel.PinActiveTabCommand}" />
                            <MenuFlyoutItem Text="Duplicate Active" Command="{x:Bind ViewModel.DuplicateActiveTabCommand}" />
                            <MenuFlyoutItem Text="Sleep Active" Command="{x:Bind ViewModel.SleepActiveTabCommand}" />
                            <MenuFlyoutItem Text="Ghost Active" Command="{x:Bind ViewModel.GhostActiveTabCommand}" />
                            <MenuFlyoutItem Text="Keep Awake Active" Command="{x:Bind ViewModel.ToggleKeepAwakeActiveTabCommand}" />
                            <MenuFlyoutItem Text="Close Active" Command="{x:Bind ViewModel.CloseActiveTabCommand}" />
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem x:Name="DeveloperModeItem" Text="Developer Mode" Click="OnToggleDeveloperMode" />
                            <MenuFlyoutItem Text="Open Settings..." Click="OnOpenSettings" />
                            <MenuFlyoutItem Text="Memory Panel..." Click="OnOpenMemoryPanel" />
                            <MenuFlyoutItem Text="AI Command Bar..." Click="OnOpenAiPanel" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>

        <!-- Tab strip -->
        <Border Grid.Row="1" Padding="8,4" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}">
            <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Tabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="tabs:TabRecord">
                            <!--
                                The whole tab body selects the tab.
                                The X button stops event propagation so it
                                does not also trigger selection.
                            -->
                            <Border CornerRadius="6"
                                    Padding="8,4"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    Tapped="OnTabBodyTapped"
                                    Tag="{x:Bind Id}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="&#x1F4CC;" Visibility="{Binding Pinned}" FontSize="11" />
                                    <TextBlock Text="&#x1F507;" Visibility="{Binding Muted}" FontSize="11" />
                                    <TextBlock Text="{x:Bind Title}" Width="160" TextTrimming="CharacterEllipsis" />
                                    <Button Content="x" Padding="2"
                                            Click="OnTabCloseClick"
                                            Tag="{x:Bind Id}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Content / active tab view -->
        <Grid Grid.Row="2">
            <controls:BrowserHostControl x:Name="Host" />
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Padding="8,4" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="11" Opacity="0.8" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.Mode, Mode=OneWay}" FontSize="11" Opacity="0.8" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedWorkspaceName, Mode=OneWay}" FontSize="11" Opacity="0.8" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
