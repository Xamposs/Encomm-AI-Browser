<?xml version="1.0" encoding="utf-8"?>
<!--
    ENCOMM semantic brushes. Every browser surface binds to these —
    never to raw hex. Gradient use is rationed (see
    docs/UI_DESIGN_SYSTEM.md): active tab indicator, omnibox focus
    ring, AI entry point, workspace selection, logo ambience.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="EncommBackgroundBrush" Color="{ThemeResource EncommBackground}" />
    <SolidColorBrush x:Key="EncommSurfaceBrush" Color="{ThemeResource EncommSurface}" />
    <SolidColorBrush x:Key="EncommElevatedBrush" Color="{ThemeResource EncommElevated}" />
    <SolidColorBrush x:Key="EncommSecondaryBrush" Color="{ThemeResource EncommSecondary}" />
    <SolidColorBrush x:Key="EncommBorderBrush" Color="{ThemeResource EncommBorder}" />
    <SolidColorBrush x:Key="EncommTextPrimaryBrush" Color="{ThemeResource EncommTextPrimary}" />
    <SolidColorBrush x:Key="EncommTextSecondaryBrush" Color="{ThemeResource EncommTextSecondary}" />
    <SolidColorBrush x:Key="EncommTextMutedBrush" Color="{ThemeResource EncommTextMuted}" />
    <SolidColorBrush x:Key="EncommTabInactiveBrush" Color="{ThemeResource EncommTabInactive}" />
    <SolidColorBrush x:Key="EncommOmniboxBrush" Color="{ThemeResource EncommOmnibox}" />

    <SolidColorBrush x:Key="EncommAccentCyanBrush" Color="{StaticResource EncommCyan}" />
    <SolidColorBrush x:Key="EncommAccentPurpleBrush" Color="{StaticResource EncommPurple}" />
    <SolidColorBrush x:Key="EncommDangerBrush" Color="{StaticResource EncommDanger}" />
    <SolidColorBrush x:Key="EncommSuccessBrush" Color="{StaticResource EncommSuccess}" />
    <SolidColorBrush x:Key="EncommWarningBrush" Color="{StaticResource EncommWarning}" />

    <!-- The brand gradient: cyan -> blue -> purple. Rationed use only. -->
    <LinearGradientBrush x:Key="EncommGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{StaticResource EncommCyan}" Offset="0.0" />
        <GradientStop Color="{StaticResource EncommBlue}" Offset="0.5" />
        <GradientStop Color="{StaticResource EncommPurple}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- 2px active-tab indicator (vertical accent on the tab's left edge
         is drawn by the tab template; this horizontal variant is used
         for workspace selection and focus rings). -->
    <LinearGradientBrush x:Key="EncommActiveIndicatorBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource EncommCyan}" Offset="0.0" />
        <GradientStop Color="{StaticResource EncommPurple}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Whisper-quiet omnibox focus ring (border-thickness illusion via
         a 1.5px outer border, not a glow). -->
    <LinearGradientBrush x:Key="EncommFocusRingBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{StaticResource EncommCyan}" Offset="0.0" />
        <GradientStop Color="{StaticResource EncommBlue}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- New Tab ambient light behind the logo: radial blue/purple at
         ~12% opacity over the theme background. Restrained by design.
         Theme-specific stops (a single gradient cannot adapt). -->
    <!-- (defined in ThemeDictionaries below) -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <RadialGradientBrush x:Key="EncommAmbientBrush" Center="0.5,0.42" RadiusX="0.55" RadiusY="0.45">
                <GradientStop Color="#1F2B4D" Offset="0.0" />
                <GradientStop Color="#141126" Offset="0.55" />
                <GradientStop Color="#080A10" Offset="1.0" />
            </RadialGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <RadialGradientBrush x:Key="EncommAmbientBrush" Center="0.5,0.42" RadiusX="0.55" RadiusY="0.45">
                <GradientStop Color="#1F2B4D" Offset="0.0" />
                <GradientStop Color="#141126" Offset="0.55" />
                <GradientStop Color="#080A10" Offset="1.0" />
            </RadialGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <RadialGradientBrush x:Key="EncommAmbientBrush" Center="0.5,0.42" RadiusX="0.55" RadiusY="0.45">
                <GradientStop Color="#D8E4FA" Offset="0.0" />
                <GradientStop Color="#E9EDF5" Offset="0.55" />
                <GradientStop Color="#F2F4F8" Offset="1.0" />
            </RadialGradientBrush>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
