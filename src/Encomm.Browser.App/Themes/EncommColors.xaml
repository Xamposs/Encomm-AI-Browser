<?xml version="1.0" encoding="utf-8"?>
<!--
    ENCOMM raw palette. Dark is the flagship: the "Default" dictionary
    carries dark values so the product is dark-first even before the
    user picks a theme; "Dark" mirrors it, "Light" is the clean
    off-white ENCOMM variant. Accents are identical across themes.
    See docs/UI_DESIGN_SYSTEM.md. Do NOT add neon fills here.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <Color x:Key="EncommBackground">#080A10</Color>
            <Color x:Key="EncommSurface">#0D1018</Color>
            <Color x:Key="EncommElevated">#121722</Color>
            <Color x:Key="EncommSecondary">#171D2A</Color>
            <Color x:Key="EncommBorder">#252C3B</Color>
            <Color x:Key="EncommTextPrimary">#F4F7FB</Color>
            <Color x:Key="EncommTextSecondary">#9AA6B7</Color>
            <Color x:Key="EncommTextMuted">#657084</Color>
            <Color x:Key="EncommTabInactive">#0B0E15</Color>
            <Color x:Key="EncommOmnibox">#10141D</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="EncommBackground">#080A10</Color>
            <Color x:Key="EncommSurface">#0D1018</Color>
            <Color x:Key="EncommElevated">#121722</Color>
            <Color x:Key="EncommSecondary">#171D2A</Color>
            <Color x:Key="EncommBorder">#252C3B</Color>
            <Color x:Key="EncommTextPrimary">#F4F7FB</Color>
            <Color x:Key="EncommTextSecondary">#9AA6B7</Color>
            <Color x:Key="EncommTextMuted">#657084</Color>
            <Color x:Key="EncommTabInactive">#0B0E15</Color>
            <Color x:Key="EncommOmnibox">#10141D</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="EncommBackground">#F2F4F8</Color>
            <Color x:Key="EncommSurface">#FFFFFF</Color>
            <Color x:Key="EncommElevated">#FFFFFF</Color>
            <Color x:Key="EncommSecondary">#E8ECF2</Color>
            <Color x:Key="EncommBorder">#D4DBE5</Color>
            <Color x:Key="EncommTextPrimary">#141A24</Color>
            <Color x:Key="EncommTextSecondary">#4A5568</Color>
            <Color x:Key="EncommTextMuted">#8A94A6</Color>
            <Color x:Key="EncommTabInactive">#E8ECF2</Color>
            <Color x:Key="EncommOmnibox">#EDF1F6</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <Color x:Key="EncommBackground">#000000</Color>
            <Color x:Key="EncommSurface">#000000</Color>
            <Color x:Key="EncommElevated">#1A1A1A</Color>
            <Color x:Key="EncommSecondary">#1A1A1A</Color>
            <Color x:Key="EncommBorder">#FFFFFF</Color>
            <Color x:Key="EncommTextPrimary">#FFFFFF</Color>
            <Color x:Key="EncommTextSecondary">#FFFFFF</Color>
            <Color x:Key="EncommTextMuted">#CFCFCF</Color>
            <Color x:Key="EncommTabInactive">#000000</Color>
            <Color x:Key="EncommOmnibox">#000000</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Accents: theme-independent brand constants. -->
    <Color x:Key="EncommCyan">#4DE1FC</Color>
    <Color x:Key="EncommBlue">#66A4F9</Color>
    <Color x:Key="EncommPurple">#A62DFB</Color>
    <Color x:Key="EncommDanger">#E5484D</Color>
    <Color x:Key="EncommSuccess">#3FB27F</Color>
    <Color x:Key="EncommWarning">#E8A13C</Color>
</ResourceDictionary>
