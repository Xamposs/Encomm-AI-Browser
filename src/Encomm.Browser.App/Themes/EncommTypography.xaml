<?xml version="1.0" encoding="utf-8"?>
<!--
    ENCOMM typography: native Windows (Segoe UI Variable) only, no
    bundled fonts. Compact chrome, quiet secondary text, one larger
    New Tab heading. See docs/UI_DESIGN_SYSTEM.md.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="EncommChromeText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource EncommTextSecondaryBrush}" />
    </Style>

    <Style x:Key="EncommChromeTitle" TargetType="TextBlock" BasedOn="{StaticResource EncommChromeText}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource EncommTextPrimaryBrush}" />
    </Style>

    <Style x:Key="EncommTabTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource EncommTextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="EncommQuietText" TargetType="TextBlock" BasedOn="{StaticResource EncommChromeText}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource EncommTextMutedBrush}" />
    </Style>

    <Style x:Key="EncommNewTabHeading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource EncommTextPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="EncommNewTabSub" TargetType="TextBlock" BasedOn="{StaticResource EncommChromeText}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="EncommDialogHeading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource EncommTextPrimaryBrush}" />
    </Style>
</ResourceDictionary>
