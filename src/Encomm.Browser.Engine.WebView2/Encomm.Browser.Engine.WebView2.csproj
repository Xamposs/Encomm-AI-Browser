<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMrtResourceManager>false</EnableMrtResourceManager>
    <EnableDefaultMrtResources>false</EnableDefaultMrtResources>
    <EnableDefaultPriItems>false</EnableDefaultPriItems>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <AppxPackage>false</AppxPackage>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416;CA1840;NU1603;NU1605</NoWarn>
    <RootNamespace>Encomm.Browser.Engine.WebView2</RootNamespace>
    <AssemblyName>Encomm.Browser.Engine.WebView2</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3719.77" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Encomm.Browser.Engine.Abstractions\Encomm.Browser.Engine.Abstractions.csproj" />
    <ProjectReference Include="..\Encomm.Browser.Core\Encomm.Browser.Core.csproj" />
    <ProjectReference Include="..\Encomm.Browser.Shield\Encomm.Browser.Shield.csproj" />
    <ProjectReference Include="..\Encomm.Browser.Security\Encomm.Browser.Security.csproj" />
  </ItemGroup>
</Project>
