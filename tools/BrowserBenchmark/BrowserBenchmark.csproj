<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Platforms>x64;AnyCPU</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseRidGraph>true</UseRidGraph>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416;CA1840</NoWarn>
    <RootNamespace>Encomm.Tools.BrowserBenchmark</RootNamespace>
    <AssemblyName>BrowserBenchmark</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Encomm.Browser.Core\Encomm.Browser.Core.csproj" />
    <ProjectReference Include="..\..\src\Encomm.Browser.Memory\Encomm.Browser.Memory.csproj" />
    <ProjectReference Include="..\..\src\Encomm.Browser.Settings\Encomm.Browser.Settings.csproj" />
    <ProjectReference Include="..\..\src\Encomm.Browser.Shield\Encomm.Browser.Shield.csproj" />
    <ProjectReference Include="..\..\src\Encomm.Browser.Workspaces\Encomm.Browser.Workspaces.csproj" />
  </ItemGroup>
</Project>