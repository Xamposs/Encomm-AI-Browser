<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Platforms>x64;AnyCPU</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Encomm.Tools.MemoryProbe</RootNamespace>
    <AssemblyName>MemoryProbe</AssemblyName>
    <NoWarn>$(NoWarn);CA1416;CA1840</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Encomm.Browser.Memory\Encomm.Browser.Memory.csproj" />
  </ItemGroup>
</Project>